<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <AssemblyName>StS2-UnDoFloor</AssemblyName>
    <RootNamespace>StS2UnDoFloor</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Override with `dotnet build -p:Sts2InstallDir=...` or the STS2_INSTALL_DIR environment variable. -->
    <Sts2InstallDir Condition="'$(Sts2InstallDir)' == '' and '$(STS2_INSTALL_DIR)' != ''">$(STS2_INSTALL_DIR)</Sts2InstallDir>
    <Sts2InstallDir Condition="'$(Sts2InstallDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</Sts2InstallDir>
    <Sts2RuntimeDir>$(Sts2InstallDir)\data_sts2_windows_x86_64</Sts2RuntimeDir>
    <!-- Copy the built mod into the game's mods folder after every build; disable with -p:CopyToModsFolder=false. -->
    <CopyToModsFolder Condition="'$(CopyToModsFolder)' == ''">true</CopyToModsFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- All three ship with the game; compiling against the same binaries the loader uses avoids version drift. -->
    <Reference Include="sts2">
      <HintPath>$(Sts2RuntimeDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2RuntimeDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2RuntimeDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToModsFolderOnBuild" AfterTargets="Build" Condition="'$(CopyToModsFolder)' == 'true'">
    <PropertyGroup>
      <ModsFolder>$(Sts2InstallDir)\mods\$(AssemblyName)</ModsFolder>
    </PropertyGroup>
    <MakeDir Directories="$(ModsFolder)" />
    <!-- An older manifest name must not linger next to the new one, or the loader sees two manifests. -->
    <Delete Files="$(ModsFolder)\mod_manifest.json" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)\$(AssemblyName).json" DestinationFolder="$(ModsFolder)" SkipUnchangedFiles="false" />
    <Message Text="Copied $(AssemblyName) to $(ModsFolder)" Importance="high" />
  </Target>
</Project>
